@model TiemBaDuong.Models.ChangePasswordVM
@{ ViewBag.Title = "Đổi mật khẩu"; }
<div class="container" style="max-width:480px;margin:auto;padding:20px;">
    <h2>Đổi mật khẩu</h2>
    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)
        <div><label>Mật khẩu hiện tại</label>@Html.PasswordFor(m => m.CurrentPassword)@Html.ValidationMessageFor(m => m.CurrentPassword)</div>
        <div><label>Mật khẩu mới</label>@Html.PasswordFor(m => m.NewPassword)@Html.ValidationMessageFor(m => m.NewPassword)</div>
        <div><label>Xác nhận mật khẩu mới</label>@Html.PasswordFor(m => m.ConfirmPassword)@Html.ValidationMessageFor(m => m.ConfirmPassword)</div>
        <button type="submit" class="btn">Đổi mật khẩu</button>
    }
    <p><a href="@Url.Action("ProfileInfo", "Account")">Quay lại thông tin tài khoản</a></p>
</div>
